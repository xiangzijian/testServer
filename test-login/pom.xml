<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 1. 继承你自己的父工程（子模块无需再重复写 groupId 和 version） -->
    <parent>
        <groupId>com.slg</groupId>
        <artifactId>test-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>test-login</artifactId>
    <name>test-login</name>
    <description>Login 登录鉴权服（HTTP 短连接）</description>

    <dependencies>
        <!-- 引入公共库（后续共用 Token 编解码工具类、错误码等） -->
        <dependency>
            <groupId>com.slg</groupId>
            <artifactId>test-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 3. 脱离 starter-parent 后，插件必须显式指定 version 和 repackage -->
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>